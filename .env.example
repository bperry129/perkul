# ---------------------------------------------------------------------------
# Perkul environment
# Copy to .env.local for development. Set the same values in Vercel for prod.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe for the browser; RLS denies all answer data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. SERVER ONLY. Never expose to the browser.
# Used by gameplay/admin server routes and the seed scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL (used for auth redirects and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: brand override without touching code
NEXT_PUBLIC_BRAND_NAME=Perkul

# Optional: comma separated emails automatically promoted to admin on seed
ADMIN_EMAILS=

# Resend Contacts API. Supabase Auth already relays "confirm your email" mail
# through Resend's SMTP, which never touches the Contacts API — these two
# make every signup also land in Resend's "All Contacts" audience.
# RESEND_API_KEY: dashboard → API Keys.
# RESEND_AUDIENCE_ID: dashboard → Audiences → the audience id in the URL.
# Missing either one degrades to a no-op (logged), never a broken signup.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

