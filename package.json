{
  "name": "perkul",
  "version": "1.0.0",
  "private": true,
  "description": "Perkul - a daily timed vocabulary game. Five words. One is fake.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
